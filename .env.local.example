# ==================================================================
#  Ruby Debby Fashion Home - environment variables
#
#  Copy this file to ".env.local" and fill in your own values:
#      Copy-Item .env.local.example .env.local
#
#  ".env.local" is git-ignored, so your secrets stay on your machine.
# ==================================================================

# ---- Supabase (Supabase dashboard -> Project Settings -> API) ----
# Safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SERVER-ONLY. Never put this in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Mailgun (Mailgun dashboard -> Sending -> Domain settings / API keys) ----
MAILGUN_API_KEY=your-private-api-key
MAILGUN_DOMAIN=sandbox1234abcd.mailgun.org
# "us" or "eu" - the two regions use different API addresses
MAILGUN_REGION=us
MAILGUN_FROM=Ruby Debby Fashion Home <postmaster@sandbox1234abcd.mailgun.org>
# Where the "you have a new order" alert is sent
ORDER_NOTIFICATION_EMAIL=you@example.com

# ---- Shop settings ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Currency shown on the site. Ruby Debby Fashion Home is in Nigeria, so
# Naira is the default. You can change it to USD, GBP, EUR, GHS, ZAR or KES.
NEXT_PUBLIC_CURRENCY=NGN