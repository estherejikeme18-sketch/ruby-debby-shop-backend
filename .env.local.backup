

#  Ruby Debby Fashion Home - your settings
#
#  This file is git-ignored, so your keys stay on your machine.
#  The shop settings are already filled in. All you need to do is
#  paste in your keys from Supabase and Mailgun (see README.md).
#
#  After changing anything here, stop the site with Ctrl+C and run
#  `npm run dev` again - environment variables are only read at startup.
# ==================================================================

# ---- Supabase (Supabase dashboard -> Project Settings -> API) ----
# Paste these three in when you are ready to connect the database.
NEXT_PUBLIC_SUPABASE_URL=https://evargxlgafxcwhukqahd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xhj1VEzUmO578VWNqdAirw_S9sb8-jy




NEXT_PUBLIC_SUPABASE_ANON_KEY=<paste the Publishable/anon key here>
SUPABASE_SERVICE_ROLE_KEY=<paste the Secret/service_role key here>

NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY. Never put this in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# "us" or "eu" - the two regions use different API addresses
MAILGUN_REGION=us
# Leave blank to use "Ruby Debby Fashion Home <postmaster@your-domain>"
MAILGUN_FROM=
# Where the "you have a new order" alert is sent
ORDER_NOTIFICATION_EMAIL=

# ---- Shop settings ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Ruby Debby Fashion Home is in Nigeria, so prices are shown in Naira.
NEXT_PUBLIC_CURRENCY=NGN